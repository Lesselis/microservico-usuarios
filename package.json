  "description": "Microsserviço responsável por **autenticação e perfis de usuários**, incluindo: - Acesso público (visitantes) - Controle de roles (`BIBLIOTECARIO`, `ADMIN`)",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "migrate": "sequelize db:migrate --env development",
